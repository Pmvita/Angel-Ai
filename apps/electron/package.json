{
  "name": "@angel/electron",
  "productName": "angel AI",
  "version": "2.0.0",
  "description": "angel AI — invisible real-time AI assistant desktop app",
  "main": "./dist/main.js",
  "private": true,
  "scripts": {
    "dev": "electron .",
    "build": "tsc && node -e \"const fs=require('fs');fs.cpSync('dist/apps/electron/src','dist',{recursive:true,dereference:true});\" && electron-builder --win",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "clean": "rm -rf dist node_modules"
  },
  "build": {
    "appId": "com.angel.ai",
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "build/icon.png"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "dist/main.js"
    }
  },
  "dependencies": {
    "@angel/config": "*",
    "@angel/types": "*",
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1",
    "typescript": "^5.5.0"
  }
}
