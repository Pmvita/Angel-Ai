# AngelAi server (apps/server)
PORT=4000
angel_DATA_DIR=

# Optional AI defaults (can also be set in the desk Settings tab)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Optional Stripe activation / checkout
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
APP_URL=http://localhost:3001

# Optional email export
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@angelai.local

# Web (apps/web) — bake at build time for static export
# NEXT_PUBLIC_API_BASE=http://localhost:4000
